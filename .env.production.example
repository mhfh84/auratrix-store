# ─── Database ────────────────────────────────────────────────────────────────
# SQLite file path — relative to the project root on the server
DATABASE_URL="file:./prisma/prod.db"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret → run: openssl rand -hex 32
NEXTAUTH_SECRET="REPLACE_WITH_YOUR_32_CHAR_SECRET"

# Your live domain — no trailing slash
NEXTAUTH_URL="https://yourdomain.com"

# ─── Site URL (used in metadata / sitemap) ────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ─── Email (optional — only if you enable email notifications) ────────────
# RESEND_API_KEY="re_..."
# FROM_EMAIL="orders@yourdomain.com"

# ─── Node ────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000
